[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
ClassVer=2.0
Provider=%Manufacturer%
CatalogFile=YomadoDriver.cat
DriverVer=10/15/2026,0.1.0.1
PnpLockDown=1

[Manufacturer]
%Manufacturer%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%DeviceName%=Install,Root\YomadoVirtualDisplay

[SourceDisksNames]
1=%DiskName%
[SourceDisksFiles]
YomadoDriver.dll=1

[Install.NT]
Include=WUDFRD.inf
Needs=WUDFRD.NT
CopyFiles=DriverFiles

[Install.NT.HW]
Include=WUDFRD.inf
Needs=WUDFRD.NT.HW
AddReg=DeviceSettings

[DeviceSettings]
HKR,,UpperFilters,0x00010000,"IndirectKmd"
HKR,WUDF,DeviceGroupId,0x00000000,"Yomado.Windows.IddCx"
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Install.NT.Services]
Include=WUDFRD.inf
Needs=WUDFRD.NT.Services

[Install.NT.Wdf]
UmdfService=YomadoDriver,Service
UmdfServiceOrder=YomadoDriver
UmdfKernelModeClientPolicy=AllowKernelModeClients

[Service]
UmdfLibraryVersion=2.25.0
ServiceBinary=%12%\UMDF\YomadoDriver.dll
UmdfExtensions=IddCx0102

[DestinationDirs]
DriverFiles=12,UMDF
[DriverFiles]
YomadoDriver.dll

[Strings]
Manufacturer="Yomado contributors"
DeviceName="Yomado Virtual Display Adapter"
DiskName="Yomado Windows Driver"
