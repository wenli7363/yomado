<Window x:Class="Yomado.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Yomado.App"
        Title="yomado · 夜窗" Width="1180" Height="650" MinWidth="780" MinHeight="440"
        Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PanelForeground}"
        Icon="Assets/Yomado.ico" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Margin="28,24,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="Assets/Yomado.ico" Width="40" Height="40" Margin="0,0,14,0" />
        <StackPanel><TextBlock Text="yomado · 夜窗" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="为 Agent 留一块工作屏" FontSize="13" Foreground="{DynamicResource MutedForeground}" Margin="0,3,0,0" /></StackPanel>
      </StackPanel>
      <Button Grid.Column="1" Content="＋ 新建屏幕" ToolTip="填写名称和分辨率后创建并启动虚拟屏" AutomationProperties.Name="新建屏幕" Click="AddClicked" VerticalAlignment="Center" IsEnabled="{Binding CanCreateScreens}" />
    </Grid>
    <StackPanel Grid.Row="1" Margin="0,24,0,18">
      <StackPanel Orientation="Horizontal">
      <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedForeground}" />
      <TextBlock Text="{Binding DriverStatus}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedForeground}" />
      <Button x:Name="InstallDriverButton" Content="{Binding DriverButtonText}" Click="InstallDriverClicked" IsEnabled="{Binding CanInstallDriver}" Margin="14,0,0,0" FontSize="12" MinHeight="28" AutomationProperties.AutomationId="InstallDriverButton" ToolTip="安装需要 Windows 管理员权限；驱动就绪后此按钮会置灰。" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0">
        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DriverInstalling}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
      </ProgressBar>
      <TextBlock Text="{Binding DriverHint}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,0" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding DriverHint}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="0,0,0,12">
      <ItemsControl ItemsSource="{Binding Screens}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:ScreenCard}">
            <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}" Margin="0,0,18,0" Padding="16" CornerRadius="12"
                    BorderBrush="{Binding FrameBrush}" BorderThickness="1" Background="{DynamicResource CardBackground}" VerticalAlignment="Top"
                    AllowDrop="True" DragOver="ScreenDragOver" DragLeave="ScreenDragLeave" Drop="ScreenDropped" Tag="{Binding}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="&#xE712;" Click="ScreenMenuClicked" Tag="{Binding}" ToolTip="屏幕设置" AutomationProperties.Name="屏幕设置">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding CanManage}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                  </Button>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,5,0,10" />
                <Grid Grid.Row="2">
                  <TextBlock Text="将应用图标拖到这里" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedForeground}">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Empty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Applications}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:ApplicationRow}">
                        <Border Width="52" Height="54" Margin="0,0,8,6" Padding="8" CornerRadius="8" BorderThickness="1" ToolTip="{Binding Tooltip}"
                                AutomationProperties.Name="{Binding Tooltip}" Focusable="True" Tag="{Binding}" PreviewMouseLeftButtonDown="AppMouseDown" PreviewMouseMove="AppMouseMove" ContextMenuOpening="AppContextMenuOpening">
                          <Border.ContextMenu><ContextMenu /></Border.ContextMenu>
                          <Border.Style><Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}" /></Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" /></Trigger>
                            </Style.Triggers>
                          </Style></Border.Style>
                          <Grid Width="32" Height="32">
                            <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{DynamicResource MutedForeground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                          </Grid>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
                <TextBlock Grid.Row="3" Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,10,0,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Expander Grid.Row="3" Header="已保存的屏幕" IsExpanded="True" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource PanelForeground}">
      <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSavedProfiles}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Expander.Style>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="138" Margin="0,6,0,0">
        <ItemsControl ItemsSource="{Binding SavedProfiles}">
          <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type local:SavedProfileRow}">
            <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,0,1" Padding="8,8,4,8">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE7F4;" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource MutedForeground}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource PanelForeground}" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedForeground}" Margin="0,3,0,0" />
                  <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" Margin="0,3,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="编辑" Tag="{Binding}" Click="EditSavedProfileClicked" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{Binding Name, StringFormat=编辑 {0}}" />
                <Button Grid.Column="3" Content="{Binding StartText}" Tag="{Binding}" Click="StartSavedProfileClicked" IsEnabled="{Binding CanStart}" VerticalAlignment="Center" MinWidth="64" AutomationProperties.Name="{Binding Name, StringFormat=启动 {0}}" />
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Expander>
    <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,16" />
    <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Windows · 0.1.0" FontSize="11" Foreground="{DynamicResource MutedForeground}" VerticalAlignment="Center" />
        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Click="CheckUpdatesClicked" Margin="8,0,0,0" ToolTip="检查更新" AutomationProperties.Name="检查更新" />
        <Button Content="GitHub" Style="{StaticResource LinkButton}" Click="GitHubClicked" Margin="8,0,0,0" FontSize="11" />
        <Button Content="开源许可" Style="{StaticResource LinkButton}" Click="LicensesClicked" FontSize="11" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="虚拟屏与实体屏共享键鼠和焦点" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedForeground}" />
    </Grid>
  </Grid>
</Window>
